# Email settings (optional for future phases)
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Optional LLM providers (future phases)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Runtime paths / logging
DB_PATH=data/jobs.db
LOGS_DIR=logs
LOG_JSON=false

# Optional source auto-disable guardrail
SOURCE_AUTO_DISABLE_EMPTY=false
SOURCE_AUTO_DISABLE_SCORE_MAX=5
